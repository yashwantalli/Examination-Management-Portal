# Copy to .env for local use. Never commit the real .env file.
EMP_ENV=development
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
EMP_SECRET_KEY=change-me
# Leave empty to use local SQLite. Production example:
# DATABASE_URL=postgresql://user:password@host:5432/emp
DATABASE_URL=
EMP_TIMEZONE=Asia/Kolkata

EMP_ADMIN_EMAIL=admin@emp.local
EMP_ADMIN_PASSWORD=change-me-too
EMP_ADMIN_NAME=Portal Administrator

# Optional SMTP. Leave EMP_MAIL_SERVER empty to only log notifications in the app.
EMP_MAIL_SERVER=
EMP_MAIL_PORT=587
EMP_MAIL_USERNAME=
EMP_MAIL_PASSWORD=
EMP_MAIL_SENDER=no-reply@emp.local
EMP_MAIL_USE_TLS=1

# --- docker compose (docker compose up --build) ---
# Use letters and digits only: this value is placed inside DATABASE_URL.
POSTGRES_PASSWORD=change-me-db
